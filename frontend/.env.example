# Frontend Environment Configuration
# Copy this to .env and fill in your values

# API Configuration
VITE_API_URL=http://localhost:3000
VITE_GRAPHQL_URL=http://localhost:3000/graphql
VITE_WS_URL=ws://localhost:3000/graphql

# App Info
VITE_APP_NAME=Passport Buddy
VITE_APP_DESCRIPTION=Your travel companion

# Google Maps APIs (Optional - for location features)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_GOOGLE_GEOCODING_API_KEY=your_google_geocoding_api_key
VITE_GOOGLE_GEOLOCATION_API_KEY=your_google_geolocation_api_key

# Feature Flags
VITE_ENABLE_SOCIAL_LOGIN=false
VITE_ENABLE_PUSH_NOTIFICATIONS=false