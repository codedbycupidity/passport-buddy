#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

echo "🚀 Running pre-commit checks..."
echo "================================================="

# Exit on first error
set -e

# Run lint-staged for efficient staged file processing
log_info "📝 Running lint-staged on changed files..."

# Backend lint-staged
if [ -d "backend" ] && [ -f "backend/package.json" ]; then
    cd backend
    if npm run lint-staged 2>/dev/null || npx lint-staged; then
        log_success "✅ Backend lint-staged passed"
    else
        log_error "❌ Backend lint-staged failed"
        exit 1
    fi
    cd ..
fi

# Frontend lint-staged  
if [ -d "frontend" ] && [ -f "frontend/package.json" ]; then
    cd frontend
    if npm run lint-staged 2>/dev/null || npx lint-staged; then
        log_success "✅ Frontend lint-staged passed"
    else
        log_error "❌ Frontend lint-staged failed"
        exit 1
    fi
    cd ..
fi

# Quick type checking for critical changes
log_info "🔍 Quick type checking..."

# Backend TypeScript check
cd backend
if npm run build:check 2>/dev/null || npx tsc --noEmit; then
    log_success "✅ Backend TypeScript check passed"
else
    log_error "❌ Backend TypeScript compilation failed"
    exit 1
fi
cd ..

# Frontend TypeScript check
cd frontend
if npm run type-check 2>/dev/null || npx tsc --noEmit; then
    log_success "✅ Frontend TypeScript check passed"
else
    log_error "❌ Frontend TypeScript compilation failed"
    exit 1
fi
cd ..

# Security checks
log_info "🔒 Security checks..."

# Check for secrets in staged files
STAGED_FILES=$(git diff --cached --name-only)
if echo "$STAGED_FILES" | xargs grep -l -i "password\|secret\|key\|token" 2>/dev/null | grep -v -E "\.(md|txt|json|example|template)$" | head -3; then
    log_warning "⚠️  Potential secrets found in staged files"
    log_warning "Please review before committing"
fi

# Check for console.log in staged files
if echo "$STAGED_FILES" | grep -E "\.(js|ts|jsx|tsx)$" | xargs grep -n "console\.log" 2>/dev/null | head -3; then
    log_warning "⚠️  console.log statements found"
    log_warning "Consider removing for production"
fi

# Backend specific: Check for time handling violations
cd backend
if git diff --cached --name-only | grep "\.ts$" | xargs grep -n "new Date()" 2>/dev/null | grep -v "// ALLOWED" | head -3; then
    log_warning "⚠️  Hardcoded new Date() found"
    log_warning "Consider using proper time extraction"
fi
cd ..

log_success "🎉 All pre-commit checks passed!"
log_info "✅ Code formatted and linted"
log_info "✅ Types checked"
log_info "✅ Security scanned"
echo "================================================="